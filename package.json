{
  "name": "inversify-socket-utils",
  "version": "1.0.1202",
  "description": "Some utilities for the development of socket.io applications with Inversify.",
  "keywords": [
    "inversify",
    "socket.io"
  ],
  "homepage": "https://github.com/alxshelepenok/inversify-socket-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxshelepenok/inversify-socket-utils.git"
  },
  "license": "MIT",
  "author": "Alexander Shelepenok <alxshelepenok@gmail.com>",
  "main": "target/inversify-socket-utils.cjs",
  "module": "target/inversify-socket-utils.js",
  "types": "target/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./target/types/index.d.ts",
      "import": "./target/inversify-socket-utils.js",
      "require": "./target/inversify-socket-utils.cjs"
    }
  },
  "files": [
    "target"
  ],
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && bun run build:cjs && bun run build:esm",
    "build:cjs": "bun build src/index.ts --target=node --format=cjs --packages=external --sourcemap=linked --outdir=target --entry-naming=inversify-socket-utils.cjs",
    "build:esm": "bun build src/index.ts --target=node --format=esm --packages=external --sourcemap=linked --outdir=target --entry-naming=inversify-socket-utils.js",
    "test": "bun test",
    "clean": "rm -rf target",
    "typecheck": "tsc -p tsconfig.json",
    "semantic-release": "semantic-release",
    "start": "bun run examples/basic/server.ts"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "inversify": "^7.6.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "inversify": "^7.6.1",
    "semantic-release": "^22.0.12",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  }
}
